# Apify Instagram Scraper (apify.com → Settings → Integrations → API tokens)
# Sans cette clé, l'app affiche des photos placeholder (parfait pour la démo).
APIFY_TOKEN=

# Stripe — pour le paiement réel
# Récupérer ici : dashboard.stripe.com → Developers → API keys → Secret key
# Sans cette clé, le bouton "Débloquer" simule un succès (mode démo).
STRIPE_SECRET_KEY=
